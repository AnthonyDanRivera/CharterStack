# Copy to .env (or set in your shell / hosting dashboard). All are optional locally.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Leave unset to use SQLite (backend/db.sqlite3).
# DATABASE_URL=postgres://charterstack:charterstack@localhost:5432/charterstack
# Number of reverse proxies in front of Django (1 on Render/Railway) so throttles see the real IP.
# NUM_PROXIES=1
# Shown in the session strip.
# DEMO_SERVER_NAME=demo-server
